+        private float idleBrake;
+
+        /// <summary>
+        /// The brake held while no pedal is pressed: a light coast brake at speed that grows smoothly toward the full
+        /// standstill hold as the car slows to a stop (and is rate-limited), instead of jumping to the hold at 1 km/h,
+        /// which made the car lurch and nose-dive at parking speeds.
+        /// </summary>
+        private float EasedIdleBrake()
+        {
+            // Slowing: a soft creep brake that rises gently as speed falls. Only once the car is essentially stopped does
+            // the full hold take over, so the last bit of motion is eased out rather than clamped.
+            float nearStop = 1f - Mathf.SmoothStep(0f, 1f, Mathf.Clamp01(SpeedKmh / idleBrakeEaseKmh));
+            float creep = Mathf.Lerp(coastBrakeTorque, creepStopTorque, nearStop);
+            float target = SpeedKmh < holdBelowKmh ? standstillBrakeTorque : creep;
+            idleBrake = Mathf.MoveTowards(idleBrake, target, idleBrakeRamp * Time.fixedDeltaTime);
+            return idleBrake;
+        }
